import logging
import argparse
import os

from rfcat_cli.tx import DEFAULT_MANUFACTURER_DIR, transmit_command


if __name__ == "__main__":
    logging.basicConfig(filename='rfcat-tx-cmd.log',
                        filemode='w',
                        level=logging.DEBUG)

    logging.info("starting rfcat-tx-cmd")

    parser = argparse.ArgumentParser()
    parser.add_argument("manufacturer")
    parser.add_argument("command")

    parser.add_argument("-m", "--manu", help="use a single manufacturer file")
    parser.add_argument("-d", "--dir", help="set directory to search for manufacturer YAML files", default=DEFAULT_MANUFACTURER_DIR)
    args = parser.parse_args()

    transmit_command(
        args.manufacturer,
        args.command,
        manufacturer_dir=args.dir,
        manu_path=args.manu,
    )

    os._exit(0)
